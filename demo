function Widgets.toggle(parent, register, opts)
    local state = opts.Default or false
    local row = Instance.new("TextButton")
    row.BackgroundTransparency = 1
    row.BorderSizePixel = 0
    row.Text = ""
    row.AutoButtonColor = false
    row.Size = UDim2.new(1, 0, 0, math.floor(18 * Scale))
    row.LayoutOrder = #parent:GetChildren()
    row.Parent = parent

    local boxSize = math.floor(14 * Scale)
    local box = Instance.new("Frame")
    box.BackgroundColor3 = state and Col.Accent or Col.Control
    box.BorderSizePixel = 0
    box.AnchorPoint = Vector2.new(0, 0.5)
    box.Position = UDim2.new(0, 0, 0.5, 0)
    box.Size = UDim2.fromOffset(boxSize, boxSize)
    box.Parent = row
    doubleBorder(box)

    local lbl = makeLabel(row, opts.Name or "Toggle", 12, Col.Text)
    lbl.Position = UDim2.new(0, math.floor(20 * Scale), 0, 0)
    lbl.Size = UDim2.new(1, -math.floor(20 * Scale), 1, 0)
    track(lbl, "TextColor3", "Text")

    onThemeRefresh(function()
        if box.Parent then
            box.BackgroundColor3 = state and Col.Accent or Col.Control
        end
    end)

    local function set(v, silent)
        state = v
        box.BackgroundColor3 = state and Col.Accent or Col.Control
        if not silent and opts.Callback then opts.Callback(state) end
    end
    row.MouseButton1Click:Connect(function() set(not state) end)

    if opts.Flag then
        register(opts.Flag, opts.Default or false,
            function(v) set(v, true) end,
            function() return state end)
    end
    return { Get = function() return state end, Set = set }
end

function Widgets.slider(parent, register, opts)
    local minV = opts.Min or 0
    local maxV = opts.Max or 100
    local interval = opts.Interval or 1
    local value = opts.Default or minV
    local suffix = opts.Suffix or ""

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.BorderSizePixel = 0
    container.Size = UDim2.new(1, 0, 0, math.floor(34 * Scale))
    container.LayoutOrder = #parent:GetChildren()
    container.Parent = parent

    local lbl = makeLabel(container, opts.Name or "Slider", 12, Col.TextDim)
    lbl.Size = UDim2.new(0.7, 0, 0, math.floor(14 * Scale))
    track(lbl, "TextColor3", "TextDim")

    local valLbl = makeLabel(container, tostring(value) .. suffix, 12, Col.Accent,
        Enum.TextXAlignment.Right)
    valLbl.AnchorPoint = Vector2.new(1, 0)
    valLbl.Position = UDim2.new(1, 0, 0, 0)
    valLbl.Size = UDim2.new(0.3, 0, 0, math.floor(14 * Scale))
    track(valLbl, "TextColor3", "Accent")

    local trackF = Instance.new("Frame")
    trackF.BackgroundColor3 = Col.Control
    trackF.BorderSizePixel = 0
    trackF.Position = UDim2.new(0, 0, 0, math.floor(17 * Scale))
    trackF.Size = UDim2.new(1, 0, 0, math.floor(13 * Scale))
    trackF.Parent = container
    doubleBorder(trackF)
    track(trackF, "BackgroundColor3", "Control")

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = Col.Accent
    fill.BorderSizePixel = 0
    fill.Position = UDim2.new(0, 1, 0, 1)
    fill.Size = UDim2.new((value - minV) / (maxV - minV), -2, 1, -2)
    fill.Parent = trackF
    track(fill, "BackgroundColor3", "Accent")

    local targetT = (value - minV) / (maxV - minV)
    local visualT = targetT
    local dragging = false

    local function snap(v)
        if interval and interval > 0 then
            return math.floor((v / interval) + 0.5) * interval
        end
        return v
    end

    local function fmt(v)
        if interval < 1 then
            return string.format("%.1f", v)
        end
        return tostring(math.floor(v + 0.5))
    end

    local function apply(mx, silent)
        local rel = math.clamp((mx - trackF.AbsolutePosition.X) / trackF.AbsoluteSize.X, 0, 1)
        local raw = minV + (maxV - minV) * rel
        value = math.clamp(snap(raw), minV, maxV)
        targetT = (value - minV) / (maxV - minV)
        valLbl.Text = fmt(value) .. suffix
        if not silent and opts.Callback then opts.Callback(value) end
    end

    RunService.RenderStepped:Connect(function(dt)
        local a = math.clamp(dt * 22, 0, 1)
        visualT = visualT + (targetT - visualT) * a
        local t = math.clamp(visualT, 0, 1)
        fill.Size = UDim2.new(t, -2 * t, 1, -2)
    end)

    trackF.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            apply(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            apply(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local function set(v, silent)
        value = math.clamp(snap(v), minV, maxV)
        targetT = (value - minV) / (maxV - minV)
        visualT = targetT
        valLbl.Text = fmt(value) .. suffix
        if not silent and opts.Callback then opts.Callback(value) end
    end

    if opts.Flag then
        register(opts.Flag, opts.Default or minV,
            function(v) set(v, true) end,
            function() return value end)
    end
    return { Get = function() return value end, Set = set }
end

