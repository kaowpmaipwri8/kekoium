-- ============================================================
-- FLAG REGISTRY (per-window)
-- ============================================================
local function newFlagRegistry()
    local Flags = {}
    local function register(name, default, setFn, getFn)
        Flags[name] = { Default = default, Set = setFn, Get = getFn }
    end
    local function getAll()
        local out = {}
        for k, v in pairs(Flags) do out[k] = v.Get() end
        return out
    end
    local function applyAll(tbl)
        for k, v in pairs(Flags) do
            if tbl[k] ~= nil then pcall(v.Set, tbl[k]) end
        end
    end
    return Flags, register, getAll, applyAll
end

