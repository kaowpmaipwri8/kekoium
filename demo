        track(ob, "TextColor3", "Text")

        local pad = Instance.new("UIPadding")
        pad.PaddingLeft = UDim.new(0, math.floor(10 * Scale))
        pad.Parent = ob

        ob.MouseEnter:Connect(function() ob.BackgroundTransparency = 0 end)
        ob.MouseLeave:Connect(function() ob.BackgroundTransparency = 1 end)
        ob.MouseButton1Click:Connect(function()
            setValue(opt)
            opened = false
            list.Visible = false
            clearActiveClose(closeSelf)
        end)
    end

    local function closeSelf()
        opened = false
        list.Visible = false
        clearActiveClose(closeSelf)
    end

    field.MouseButton1Click:Connect(function()
        if opened then
            closeSelf()
        else
            setActiveClose(closeSelf)
            opened = true
            positionList()
            list.Visible = true
        end
    end)

    UserInputService.InputBegan:Connect(function(input, gp)
        if gp or not opened then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local pos = input.Position
        local function inside(g)
            if not g or not g.Parent then return false end
            local a, sz = g.AbsolutePosition, g.AbsoluteSize
            return pos.X >= a.X and pos.X <= a.X + sz.X
               and pos.Y >= a.Y and pos.Y <= a.Y + sz.Y
        end
        if not (inside(field) or inside(list)) then closeSelf() end
    end)

    if opts.Flag then
        register(opts.Flag, value,
            function(v) setValue(v, true) end,
            function() return value end)
    end
    return { Get = function() return value end, Set = setValue }
end

function Widgets.colorpicker(parent, register, overlay, bg, opts)
