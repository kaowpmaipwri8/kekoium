    sv.BorderSizePixel = 0
    sv.Position = UDim2.new(0, SV_PAD, 0, SV_PAD)
    sv.Size = UDim2.fromOffset(SV_H, SV_H)
    sv.ClipsDescendants = true
    sv.ZIndex = 921
    sv.Parent = popup
    doubleBorder(sv)

    local white = Instance.new("Frame")
    white.BackgroundColor3 = Color3.new(1,1,1)
    white.BorderSizePixel = 0
    white.Size = UDim2.new(1,0,1,0)
    white.ZIndex = 922
    white.Parent = sv
    local wg = Instance.new("UIGradient")
    wg.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(1, 1),
    })
    wg.Parent = white

    local black = Instance.new("Frame")
    black.BackgroundColor3 = Color3.new(0,0,0)
    black.BorderSizePixel = 0
    black.Size = UDim2.new(1,0,1,0)
    black.ZIndex = 923
    black.Parent = sv
    local bgr = Instance.new("UIGradient")
    bgr.Rotation = 90
    bgr.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(1, 0),
    })
    bgr.Parent = black

    local svCursor = Instance.new("Frame")
    svCursor.AnchorPoint = Vector2.new(0.5, 0.5)
    svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
    svCursor.Size = UDim2.fromOffset(4, 4)
    svCursor.BackgroundColor3 = Color3.new(1,1,1)
    svCursor.BorderSizePixel = 0
    svCursor.ZIndex = 925
    svCursor.Parent = sv
    local sc = Instance.new("UIStroke")
    sc.Color = Color3.new(0,0,0); sc.Thickness = 1
    sc.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    sc.Parent = svCursor

    local svBtn = Instance.new("TextButton")
    svBtn.BackgroundTransparency = 1
    svBtn.Size = UDim2.new(1,0,1,0)
    svBtn.Text = ""
    svBtn.ZIndex = 926
    svBtn.Parent = sv

    local hue = Instance.new("Frame")
    hue.BackgroundColor3 = Color3.new(1,1,1)
    hue.BorderSizePixel = 0
    hue.Position = UDim2.new(0, SV_PAD + SV_H + GAP, 0, SV_PAD)
    hue.Size = UDim2.fromOffset(HUE_W, SV_H)
    hue.ZIndex = 921
    hue.Parent = popup
    doubleBorder(hue)

    local hg = Instance.new("UIGradient")
    hg.Rotation = 90
    hg.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255,0,0)),
        ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255,255,0)),
        ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0,255,0)),
        ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0,255,255)),
        ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0,0,255)),
        ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255,0,255)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255,0,0)),
    })
    hg.Parent = hue

    local hueCursor = Instance.new("Frame")
    hueCursor.AnchorPoint = Vector2.new(0.5, 0.5)
    hueCursor.Position = UDim2.new(0.5, 0, h, 0)
    hueCursor.Size = UDim2.new(1, 2, 0, 2)
    hueCursor.BackgroundColor3 = Color3.new(1,1,1)
    hueCursor.BorderSizePixel = 0
    hueCursor.ZIndex = 925
    hueCursor.Parent = hue
    local hco = Instance.new("UIStroke")
    hco.Color = Color3.new(0,0,0); hco.Thickness = 1
    hco.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    hco.Parent = hueCursor

    local hueBtn = Instance.new("TextButton")
    hueBtn.BackgroundTransparency = 1
    hueBtn.Size = UDim2.new(1,0,1,0)
    hueBtn.Text = ""
    hueBtn.ZIndex = 926
    hueBtn.Parent = hue

    local hexBox = Instance.new("TextBox")
    hexBox.FontFace = Fonts.Main
    hexBox.Text = "#" .. color:ToHex()
    hexBox.TextColor3 = Col.Text
    hexBox.TextSize = math.floor(11 * Scale)
    hexBox.BackgroundColor3 = Col.Control
    hexBox.BorderSizePixel = 0
    hexBox.ClearTextOnFocus = false
    hexBox.TextXAlignment = Enum.TextXAlignment.Center
    hexBox.Position = UDim2.new(0, SV_PAD, 0, SV_PAD + SV_H + GAP)
    hexBox.Size = UDim2.new(1, -SV_PAD * 2, 0, HEX_H)
    hexBox.ZIndex = 921
    hexBox.Parent = popup
    doubleBorder(hexBox)
    textStroke(hexBox)
    track(hexBox, "BackgroundColor3", "Control")
    track(hexBox, "TextColor3", "Text")

    local function refresh(silent)
        color = Color3.fromHSV(h, s, v)
        swatch.BackgroundColor3 = color
        sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
        hueCursor.Position = UDim2.new(0.5, 0, h, 0)
        hexBox.Text = "#" .. color:ToHex()
        if not silent and opts.Callback then opts.Callback(color, 1) end
    end

    local function positionPopup()
        local bgPos = bg.AbsolutePosition
        local swPos = swatch.AbsolutePosition
        local swSize= swatch.AbsoluteSize
        local bgSize= bg.AbsoluteSize
        local px = swPos.X - bgPos.X + swSize.X - POP_W
        local py = swPos.Y - bgPos.Y + swSize.Y + 4
        if px < 4 then px = 4 end
        if px + POP_W > bgSize.X - 4 then px = bgSize.X - POP_W - 4 end
        if py + POP_H > bgSize.Y - 4 then py = swPos.Y - bgPos.Y - POP_H - 4 end
        if py < 4 then py = 4 end
        popup.Position = UDim2.fromOffset(px, py)
    end

    local function closeSelf()
        opened = false
        popup.Visible = false
        clearActiveClose(closeSelf)
    end

    swatch.MouseButton1Click:Connect(function()
        if opened then
            closeSelf()
        else
            setActiveClose(closeSelf)
            opened = true
            positionPopup()
            popup.Visible = true
        end
    end)

    local draggingSV = false
    svBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingSV = true
            s = math.clamp((input.Position.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
            v = math.clamp(1 - (input.Position.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
            refresh()
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not draggingSV then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            s = math.clamp((input.Position.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
            v = math.clamp(1 - (input.Position.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
            refresh()
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingSV = false
        end
    end)

    local draggingHue = false
    hueBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingHue = true
            h = math.clamp((input.Position.Y - hue.AbsolutePosition.Y) / hue.AbsoluteSize.Y, 0, 1)
            refresh()
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not draggingHue then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            h = math.clamp((input.Position.Y - hue.AbsolutePosition.Y) / hue.AbsoluteSize.Y, 0, 1)
            refresh()
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingHue = false
        end
    end)

    hexBox.FocusLost:Connect(function()
        local txt = hexBox.Text:gsub("#",""):gsub(" ","")
        if #txt == 6 then
            local ok, c = pcall(function() return Color3.fromHex(txt) end)
            if ok and c then
                color = c
                h, s, v = color:ToHSV()
                refresh(false)
                return
            end
        end
        refresh(true)
    end)

    UserInputService.InputBegan:Connect(function(input, gp)
        if gp or not opened then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local pos = input.Position
        local function inside(g)
            if not g or not g.Parent then return false end
            local a, sz = g.AbsolutePosition, g.AbsoluteSize
            return pos.X >= a.X and pos.X <= a.X + sz.X
               and pos.Y >= a.Y and pos.Y <= a.Y + sz.Y
        end
        if not (inside(swatch) or inside(popup)) then closeSelf() end
    end)

    refresh(true)

    if opts.Flag then
        register(opts.Flag, "#" .. color:ToHex(), function(v)
            if typeof(v) == "Color3" then color = v
            elseif type(v) == "string" then
                local txt = v:gsub("#","")
                local ok, c = pcall(function() return Color3.fromHex(txt) end)
                if ok then color = c end
            end
            h, s, v = color:ToHSV()
            refresh(true)
        end, function() return "#" .. color:ToHex() end)
    end
    return { Get = function() return color end, Set = function(c)
        color = c; h, s, v = color:ToHSV(); refresh(true)
    end }
end

