-- ============================================================
-- THEME REGISTRY
-- ============================================================
local ThemeRegistry = {}
local ThemeRefresh  = {}

local function onThemeRefresh(fn) table.insert(ThemeRefresh, fn) end
local function track(obj, prop, key)
    table.insert(ThemeRegistry, { obj = obj, prop = prop, key = key })
    if Col[key] then obj[prop] = Col[key] end
end
local function refreshThemeCallbacks()
    for _, fn in ipairs(ThemeRefresh) do pcall(fn) end
end
local function updateTheme(key, color)
    Col[key] = color
    for _, e in ipairs(ThemeRegistry) do
        if e.key == key and e.obj and e.obj.Parent then
            pcall(function() e.obj[e.prop] = color end)
        end
    end
    refreshThemeCallbacks()
end

local function applyThemePreset(name)
    local preset = ThemePresets[name]
    if preset then
        for k, v in pairs(preset) do updateTheme(k, v) end
        return true
    end
    return false
end

