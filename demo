local Library = {}

local function newWindow(opts)
    opts = opts or {}
    local W = (opts.Size and opts.Size.X.Offset) or math.floor(550 * Scale)
    local H = (opts.Size and opts.Size.Y.Offset) or math.floor(650 * Scale)

    local Flags, register, getAll, applyAll = newFlagRegistry()

    local BG = Instance.new("Frame")
    BG.BackgroundColor3 = Col.BG
    BG.BorderSizePixel = 0
    BG.Size = UDim2.new(0, W, 0, H)
    BG.Position = UDim2.new(0.5, -W/2, 0.5, -H/2)
    BG.Name = "Window"
    BG.Parent = Screen
    BG.ClipsDescendants = true
    doubleBorder(BG)
    track(BG, "BackgroundColor3", "BG")

    local Overlay = Instance.new("Frame")
    Overlay.BackgroundTransparency = 1
    Overlay.Size = UDim2.new(1,0,1,0)
    Overlay.ZIndex = 900
    Overlay.ClipsDescendants = true
    Overlay.Parent = BG

    local Title = makeLabel(BG, opts.Name or "Nebula", 11, Col.Accent)
    Title.Position = UDim2.new(0, OFFSET, 0, 0)
    Title.Size = UDim2.new(1, -OFFSET*2, 0, TITLE_H)
    track(Title, "TextColor3", "Accent")

    -- Home container
    local Home = Instance.new("Frame")
    Home.BackgroundColor3 = Col.Panel
    Home.BorderSizePixel = 0
    Home.Position = UDim2.new(0, OFFSET, 0, TITLE_H + 2)
    Home.Size = UDim2.new(1, -OFFSET*2, 1, -(TITLE_H + 2 + OFFSET))
    Home.Parent = BG
    Home.ClipsDescendants = true
    doubleBorder(Home)
    track(Home, "BackgroundColor3", "Panel")

    -- Tab bar
    local tabHolder = Instance.new("Frame")
    tabHolder.BackgroundTransparency = 1
    tabHolder.Position = UDim2.new(0, TABBAR_TOP, 0, TABBAR_TOP)
    tabHolder.Size = UDim2.new(1, -TABBAR_TOP*2, 0, TAB_H)
    tabHolder.ZIndex = 3
    tabHolder.Parent = Home

    local tabLayout = Instance.new("UIListLayout")
    tabLayout.FillDirection = Enum.FillDirection.Horizontal
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tabLayout.Padding = UDim.new(0, TAB_GAP)
    tabLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    tabLayout.Parent = tabHolder

    -- Content frame
    local CONTENT_TOP = TABBAR_TOP + TAB_H
    local ContentFrame = Instance.new("Frame")
    ContentFrame.BackgroundColor3 = Col.Content
    ContentFrame.BorderSizePixel = 0
    ContentFrame.Position = UDim2.new(0, TABBAR_TOP, 0, CONTENT_TOP)
    ContentFrame.Size = UDim2.new(1, -TABBAR_TOP*2, 1, -(CONTENT_TOP + TABBAR_TOP))
    ContentFrame.ZIndex = 1
    ContentFrame.Parent = Home
    ContentFrame.ClipsDescendants = true
    track(ContentFrame, "BackgroundColor3", "Content")

    do
        local function line(key, pos, size, z)
            local f = Instance.new("Frame")
            f.BackgroundColor3 = Col[key]
            f.BorderSizePixel = 0
            f.Position = pos; f.Size = size; f.ZIndex = z
            f.Parent = ContentFrame
            track(f, "BackgroundColor3", key)
            return f
        end
        local z = 2
        line("Outer",  UDim2.new(0,0,0,0),   UDim2.new(0,1,1,0), z)
        line("Outer",  UDim2.new(1,-1,0,0),  UDim2.new(0,1,1,0), z)
        line("Outer",  UDim2.new(0,0,1,-1),  UDim2.new(1,0,0,1), z)
        line("Inline", UDim2.new(0,1,0,0),   UDim2.new(0,1,1,-1), z)
        line("Inline", UDim2.new(1,-2,0,0),  UDim2.new(0,1,1,-1), z)
        line("Inline", UDim2.new(0,1,1,-2),  UDim2.new(1,-2,0,1), z)

        local topOL = line("Outer",  UDim2.new(0,0,0,0), UDim2.new(0,0,0,1), z)
        local topOR = line("Outer",  UDim2.new(0,0,0,0), UDim2.new(0,0,0,1), z)
        local topIL = line("Inline", UDim2.new(0,0,0,1), UDim2.new(0,0,0,1), z)
        local topIR = line("Inline", UDim2.new(0,0,0,1), UDim2.new(0,0,0,1), z)

        local currentNotch = nil
        local function setTopBorder(nx1, nx2)
            local w = ContentFrame.AbsoluteSize.X
            if w <= 0 then w = ContentFrame.Size.X.Offset end
            local a = nx1 or 0
            local b = nx2 or w
            if b < a then a, b = b, a end
            a = math.max(0, a); b = math.min(w, b)
            topOL.Position = UDim2.new(0,0,0,0);  topOL.Size = UDim2.new(0,a,0,1)
            topOR.Position = UDim2.new(0,b,0,0);  topOR.Size = UDim2.new(0, math.max(0,w-b), 0, 1)
            topIL.Position = UDim2.new(0,0,0,1);  topIL.Size = UDim2.new(0,a,0,1)
            topIR.Position = UDim2.new(0,b,0,1);  topIR.Size = UDim2.new(0, math.max(0,w-b), 0, 1)
        end
        onThemeRefresh(function()
            if ContentFrame.Parent then
                if currentNotch then setTopBorder(currentNotch[1], currentNotch[2])
                else setTopBorder(nil, nil) end
            end
        end)
        task.defer(function() setTopBorder(nil, nil) end)

        -- Tabs list
        local Tabs = {}
        local function updateNotch()
            local active = nil
            for _, t in pairs(Tabs) do
                if t.active then active = t; break end
            end
            if not active then
                currentNotch = nil; setTopBorder(nil, nil); return
            end
            local btn = active.btn
            local cpos = ContentFrame.AbsolutePosition
            local bpos = btn.AbsolutePosition
            local bsz  = btn.AbsoluteSize
            local x1 = math.floor(bpos.X - cpos.X)
            local x2 = math.ceil(bpos.X - cpos.X + bsz.X)
            currentNotch = { x1 + 1, x2 - 1 }
            setTopBorder(x1 + 1, x2 - 1)
        end

        -- Exposed tab constructor
        function newTab(tabOpts)
            local idx = #Tabs + 1
            local name = tabOpts.Name or ("Tab" .. idx)

            local btn = Instance.new("TextButton")
            btn.FontFace = Fonts.Main
            btn.Text = name
            btn.TextColor3 = Col.TextDim
            btn.TextSize = math.floor(13 * Scale)
            btn.BackgroundColor3 = Col.TabIdle
            btn.BorderSizePixel = 0
            btn.AutoButtonColor = false
            btn.LayoutOrder = idx
            btn.ZIndex = 3
            btn.Size = UDim2.new(0, TAB_W, 0, TAB_H + 1)
            btn.Parent = tabHolder
            sideBorders(btn, { top = true, left = true, right = true })

            local page = Instance.new("Frame")
            page.BackgroundTransparency = 1
            page.BorderSizePixel = 0
            page.Size = UDim2.new(1,0,1,0)
            page.Visible = (idx == 1)
            page.Parent = ContentFrame
            page.ClipsDescendants = true

            Tabs[idx] = { btn = btn, page = page, active = (idx == 1) }
            if idx == 1 then
                btn.TextColor3 = Col.Accent
                btn.BackgroundColor3 = Col.Content
            end

            onThemeRefresh(function()
                if btn.Parent then
                    if Tabs[idx] and Tabs[idx].active then
                        btn.TextColor3 = Col.Accent
                        btn.BackgroundColor3 = Col.Content
                        updateNotch()
                    else
                        btn.TextColor3 = Col.TextDim
                        btn.BackgroundColor3 = Col.TabIdle
                    end
                end
            end)

            btn.MouseButton1Click:Connect(function()
                for i, t in pairs(Tabs) do
                    local on = (i == idx)
                    t.active = on
                    t.btn.TextColor3 = on and Col.Accent or Col.TextDim
                    t.btn.BackgroundColor3 = on and Col.Content or Col.TabIdle
                    t.page.Visible = on
                end
                updateNotch()
            end)

            task.defer(function() updateNotch() end)

            return newTabObject(page, tabOpts)
        end

        -- Circular dependency: define newTabObject after page created
        function newTabObject(page, tabOpts)
            local tabObj = {}

            -- PAGE CONTENT METRICS
            local CONTENT_W = W - (OFFSET * 2) - math.floor(16 * Scale)
            local CONTENT_H = H - (TITLE_H + OFFSET) - (TABBAR_TOP + TAB_H + OFFSET)
            local SECTION_W = math.floor((CONTENT_W - PAD * 2 - GAP_X) / 2)
            local SECTION_H = CONTENT_H - PAD * 2

            local leftSection, rightSection

            function tabObj:Section(o)
                o = o or {}
                local side = o.Side or "Left"
                local x = (side == "Right")
                    and (PAD + SECTION_W + GAP_X)
                    or PAD

                local section = Instance.new("Frame")
                section.BackgroundColor3 = Col.Panel
                section.BorderSizePixel = 0
                section.Position = UDim2.new(0, x, 0, PAD)
                section.Size = UDim2.new(0, SECTION_W, 0, SECTION_H)
                section.Parent = page
                section.ClipsDescendants = true
                doubleBorder(section)
                track(section, "BackgroundColor3", "Panel")

                local header = Instance.new("Frame")
                header.BackgroundColor3 = Col.Header
                header.BorderSizePixel = 0
                header.Size = UDim2.new(1, 0, 0, HEADER_H)
                header.Parent = section
                doubleBorder(header)
                track(header, "BackgroundColor3", "Header")

                local accentLine = Instance.new("Frame")
                accentLine.BackgroundColor3 = Col.HeaderAcc
                accentLine.BorderSizePixel = 0
                accentLine.Position = UDim2.new(0, 0, 1, -1)
                accentLine.Size = UDim2.new(1, 0, 0, 1)
                accentLine.ZIndex = 6
                accentLine.Parent = header
                track(accentLine, "BackgroundColor3", "HeaderAcc")

                local nameLbl = makeLabel(header, o.Name or "Section", 12, Col.Text)
                nameLbl.Position = UDim2.new(0, math.floor(9 * Scale), 0, 0)
                nameLbl.Size = UDim2.new(1, -math.floor(18 * Scale), 1, 0)
                nameLbl.ZIndex = 7
                track(nameLbl, "TextColor3", "Text")

                local body = Instance.new("ScrollingFrame")
                body.BackgroundTransparency = 1
                body.BorderSizePixel = 0
                body.Position = UDim2.new(0, 0, 0, HEADER_H)
                body.Size = UDim2.new(1, 0, 1, -HEADER_H)
                body.CanvasSize = UDim2.new(0,0,0,0)
                body.AutomaticCanvasSize = Enum.AutomaticSize.Y
                body.ScrollBarThickness = 2
                body.ScrollBarImageColor3 = Col.Accent
                body.ScrollBarImageTransparency = 0.6
                body.ClipsDescendants = true
                body.Parent = section
                track(body, "ScrollBarImageColor3", "Accent")

                local layout = Instance.new("UIListLayout")
                layout.SortOrder = Enum.SortOrder.LayoutOrder
                layout.Padding = UDim.new(0, math.floor(5 * Scale))
                layout.Parent = body

                local pad = Instance.new("UIPadding")
                pad.PaddingTop = UDim.new(0, math.floor(7 * Scale))
                pad.PaddingBottom = UDim.new(0, math.floor(7 * Scale))
                pad.PaddingLeft = UDim.new(0, math.floor(8 * Scale))
                pad.PaddingRight = UDim.new(0, math.floor(8 * Scale))
                pad.Parent = body

                local sectionObj = {}
                function sectionObj:Toggle(o) return Widgets.toggle(body, register, o) end
                function sectionObj:Slider(o) return Widgets.slider(body, register, o) end
                function sectionObj:Dropdown(o) return Widgets.dropdown(body, register, Overlay, BG, o) end
                function sectionObj:Colorpicker(o) return Widgets.colorpicker(body, register, Overlay, BG, o) end
                function sectionObj:Button(o) return Widgets.button(body, o) end
                function sectionObj:Textbox(o) return Widgets.textbox(body, register, o) end
                function sectionObj:Keybind(o) return Widgets.keybind(body, register, o) end
                return sectionObj
            end

            -- PlayerList
            function tabObj:PlayerList(o)
                o = o or {}
                local holder = Instance.new("Frame")
                holder.BackgroundColor3 = Col.Panel
                holder.BorderSizePixel = 0
                holder.Position = UDim2.new(0, PAD, 0, PAD)
                holder.Size = UDim2.new(1, -PAD * 2, 1, -PAD * 2)
                holder.Parent = page
                doubleBorder(holder)
                track(holder, "BackgroundColor3", "Panel")

                local header = Instance.new("Frame")
                header.BackgroundColor3 = Col.Header
                header.BorderSizePixel = 0
                header.Size = UDim2.new(1, 0, 0, HEADER_H)
                header.Parent = holder
                doubleBorder(header)
                track(header, "BackgroundColor3", "Header")

                local headerLbl = makeLabel(header, o.Name or "Players", 12, Col.Text)
                headerLbl.Position = UDim2.new(0, math.floor(9 * Scale), 0, 0)
                headerLbl.Size = UDim2.new(1, -math.floor(18 * Scale), 1, 0)
                headerLbl.ZIndex = 7
                track(headerLbl, "TextColor3", "Text")

                local accentLine = Instance.new("Frame")
                accentLine.BackgroundColor3 = Col.HeaderAcc
                accentLine.BorderSizePixel = 0
                accentLine.Position = UDim2.new(0, 0, 1, -1)
                accentLine.Size = UDim2.new(1, 0, 0, 1)
                accentLine.ZIndex = 6
                accentLine.Parent = header
                track(accentLine, "BackgroundColor3", "HeaderAcc")

                local scroll = Instance.new("ScrollingFrame")
                scroll.BackgroundTransparency = 1
                scroll.BorderSizePixel = 0
                scroll.Position = UDim2.new(0, 1, 0, HEADER_H)
                scroll.Size = UDim2.new(1, -2, 1, -(HEADER_H + 1))
                scroll.CanvasSize = UDim2.new(0,0,0,0)
                scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
                scroll.ScrollBarThickness = 2
                scroll.ScrollBarImageColor3 = Col.Accent
                scroll.ScrollBarImageTransparency = 0.6
                scroll.Parent = holder
                track(scroll, "ScrollBarImageColor3", "Accent")

                local layout = Instance.new("UIListLayout")
                layout.SortOrder = Enum.SortOrder.LayoutOrder
                layout.Padding = UDim.new(0, 2)
                layout.Parent = scroll

                local pad = Instance.new("UIPadding")
                pad.PaddingTop = UDim.new(0, math.floor(6 * Scale))
                pad.PaddingBottom = UDim.new(0, math.floor(6 * Scale))
                pad.PaddingLeft = UDim.new(0, math.floor(6 * Scale))
                pad.PaddingRight = UDim.new(0, math.floor(6 * Scale))
                pad.Parent = scroll

                local function buildRow(player)
                    local row = Instance.new("Frame")
                    row.BackgroundColor3 = Col.Control
                    row.BackgroundTransparency = 1
                    row.BorderSizePixel = 0
                    row.Size = UDim2.new(1, 0, 0, math.floor(22 * Scale))
                    row.LayoutOrder = player.UserId
                    row.Name = player.Name
                    row.Parent = scroll
                    track(row, "BackgroundColor3", "Control")

                    local nameLbl = makeLabel(row, player.Name, 12, Col.Text)
                    nameLbl.Position = UDim2.new(0, math.floor(8 * Scale), 0, 0)
                    nameLbl.Size = UDim2.new(1, -math.floor(16 * Scale), 1, 0)
                    track(nameLbl, "TextColor3", "Text")

                    local btn = Instance.new("TextButton")
                    btn.FontFace = Fonts.Main
                    btn.Text = "Kick"
                    btn.TextColor3 = Col.TextDim
                    btn.TextSize = math.floor(10 * Scale)
                    btn.BackgroundColor3 = Col.ControlHov
                    btn.BorderSizePixel = 0
                    btn.AutoButtonColor = false
                    btn.AnchorPoint = Vector2.new(1, 0.5)
                    btn.Position = UDim2.new(1, -math.floor(6 * Scale), 0.5, 0)
                    btn.Size = UDim2.fromOffset(math.floor(34 * Scale), math.floor(16 * Scale))
                    btn.Parent = row
                    doubleBorder(btn)
                    textStroke(btn)
                    track(btn, "BackgroundColor3", "ControlHov")
                    track(btn, "TextColor3", "TextDim")

                    btn.MouseButton1Click:Connect(function()
                        if o.OnKick then
                            pcall(o.OnKick, player)
                        else
                            Notifications:Create({
                                Name = "Kicked " .. player.Name .. " (visual only)",
                                LifeTime = 2,
                            })
                        end
                    end)
                end

                for _, p in ipairs(Players:GetPlayers()) do
                    buildRow(p)
                end
                Players.PlayerAdded:Connect(buildRow)
                Players.PlayerRemoving:Connect(function(p)
                    local r = scroll:FindFirstChild(p.Name)
                    if r then r:Destroy() end
                end)
                return { Container = holder, Scroll = scroll }
            end

            return tabObj
        end
    end

    local windowObj = {}

    function windowObj:Tab(o)
        return newTab(o or {})
    end

    function windowObj:Configs(o)
        -- Build a Settings tab dynamically
        local settingsTab = newTab({ Name = "Configs" })

        local leftSection = settingsTab:Section({ Name = "Configs", Side = "Left" })
        local rightSection = settingsTab:Section({ Name = "Themes", Side = "Right" })

        local selected = nil
        local newNameBox = Widgets.textbox(leftSection, register, {
            Name = "Config name", Placeholder = "type a name..."
        })

        -- listbox of files
        local listHolder = Instance.new("Frame")
        listHolder.BackgroundColor3 = Col.Control
        listHolder.BorderSizePixel = 0
        listHolder.Size = UDim2.new(1, 0, 0, math.floor(140 * Scale))
        listHolder.LayoutOrder = #leftSection:GetChildren()
        listHolder.Parent = leftSection
        doubleBorder(listHolder)
        track(listHolder, "BackgroundColor3", "Control")

        local scroll = Instance.new("ScrollingFrame")
        scroll.BackgroundTransparency = 1
        scroll.BorderSizePixel = 0
        scroll.Position = UDim2.new(0,1,0,1)
        scroll.Size = UDim2.new(1,-2,1,-2)
        scroll.CanvasSize = UDim2.new(0,0,0,0)
        scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        scroll.ScrollBarThickness = 2
        scroll.ScrollBarImageColor3 = Col.Accent
        scroll.Parent = listHolder
        track(scroll, "ScrollBarImageColor3", "Accent")

        local layout = Instance.new("UIListLayout")
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0, 1)
        layout.Parent = scroll

        local pad = Instance.new("UIPadding")
        pad.PaddingTop = UDim.new(0, 4); pad.PaddingBottom = UDim.new(0, 4)
        pad.PaddingLeft = UDim.new(0, 4); pad.PaddingRight = UDim.new(0, 4)
        pad.Parent = scroll

        local function refreshList()
            for _, c in ipairs(scroll:GetChildren()) do
                if c:IsA("TextButton") then c:Destroy() end
            end
            local files = {}
            local ok, list = pcall(listfiles, "Nebula/Configs")
            if ok and list then
                for _, path in ipairs(list) do
                    local nm = path:match("([^/\\]+)%.json$")
                    if nm then table.insert(files, nm) end
                end
            end
            table.sort(files)
            for i, nm in ipairs(files) do
                local b = Instance.new("TextButton")
                b.FontFace = Fonts.Main
                b.Text = nm
                b.TextColor3 = Col.Text
                b.TextSize = math.floor(12 * Scale)
                b.TextXAlignment = Enum.TextXAlignment.Left
                b.BackgroundColor3 = Col.ControlHov
                b.BackgroundTransparency = 1
                b.BorderSizePixel = 0
                b.AutoButtonColor = false
                b.LayoutOrder = i
                b.Size = UDim2.new(1,0,0, math.floor(20 * Scale))
                b.Parent = scroll
                textStroke(b)
                track(b, "TextColor3", "Text")
                track(b, "BackgroundColor3", "ControlHov")

                local bp = Instance.new("UIPadding")
                bp.PaddingLeft = UDim.new(0, math.floor(8 * Scale))
                bp.Parent = b

                b.MouseEnter:Connect(function() b.BackgroundTransparency = 0 end)
                b.MouseLeave:Connect(function()
                    if selected ~= nm then b.BackgroundTransparency = 1 end
                end)
                b.MouseButton1Click:Connect(function()
                    selected = nm
                    for _, c in ipairs(scroll:GetChildren()) do
                        if c:IsA("TextButton") then
                            c.BackgroundTransparency = (c.Text == nm) and 0 or 1
                            c.TextColor3 = (c.Text == nm) and Col.Accent or Col.Text
                        end
                    end
                end)
            end
        end
        refreshList()

        Widgets.button(leftSection, { Name = "Create", Callback = function()
            local nm = newNameBox.Get()
            if nm == "" then return Notifications:Create({ Name = "enter a name", LifeTime = 2 }) end
            local ok = pcall(function()
                writefile("Nebula/Configs/" .. nm .. ".json",
                    HttpService:JSONEncode(getAll()))
            end)
            if ok then
                Notifications:Create({ Name = "created: " .. nm, LifeTime = 2 })
                refreshList()
            end
        end })
        Widgets.button(leftSection, { Name = "Load", Callback = function()
            if not selected then return Notifications:Create({ Name = "select a config", LifeTime = 2 }) end
            local path = "Nebula/Configs/" .. selected .. ".json"
            if not isfile(path) then return Notifications:Create({ Name = "not found", LifeTime = 2 }) end
            local ok, dec = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
            if ok and type(dec) == "table" then
                applyAll(dec)
                Notifications:Create({ Name = "loaded: " .. selected, LifeTime = 2 })
            end
        end })
        Widgets.button(leftSection, { Name = "Overwrite", Callback = function()
            if not selected then return Notifications:Create({ Name = "select a config", LifeTime = 2 }) end
            local ok = pcall(function()
                writefile("Nebula/Configs/" .. selected .. ".json",
                    HttpService:JSONEncode(getAll()))
            end)
            if ok then Notifications:Create({ Name = "overwrote: " .. selected, LifeTime = 2 }) end
        end })
        Widgets.button(leftSection, { Name = "Delete", Callback = function()
            if not selected then return Notifications:Create({ Name = "select a config", LifeTime = 2 }) end
            local path = "Nebula/Configs/" .. selected .. ".json"
            if isfile(path) then
                pcall(delfile, path)
                Notifications:Create({ Name = "deleted: " .. selected, LifeTime = 2 })
                selected = nil
                refreshList()
            end
        end })

        -- Themes on the right section
        local presetOptions = { "Default", "Hell", "Ember" }
        local themeNameBox = Widgets.textbox(rightSection, register, {
            Name = "Theme name", Placeholder = "save current as..."
        })
        Widgets.dropdown(rightSection, register, Overlay, BG, {
            Name = "Preset",
            Options = presetOptions,
            Default = "Default",
            Callback = function(v)
                if applyThemePreset(v) then
                    Notifications:Create({ Name = "theme: " .. v, LifeTime = 2 })
                end
            end
        })
        Widgets.button(rightSection, { Name = "Save theme", Callback = function()
            local nm = themeNameBox.Get()
            if nm == "" then return end
            local data = {}
            for k, v in pairs(Col) do
                if typeof(v) == "Color3" then
                    data[k] = { R = v.R, G = v.G, B = v.B }
                end
            end
            pcall(function()
                writefile("Nebula/Themes/" .. nm .. ".json", HttpService:JSONEncode(data))
            end)
            Notifications:Create({ Name = "saved theme: " .. nm, LifeTime = 2 })
        end })
        Widgets.colorpicker(rightSection, register, Overlay, BG, {
            Name = "Accent", Color = Col.Accent,
            Callback = function(c) updateTheme("Accent", c) end
        })
        Widgets.colorpicker(rightSection, register, Overlay, BG, {
            Name = "Panel", Color = Col.Panel,
            Callback = function(c) updateTheme("Panel", c) end
        })
        Widgets.colorpicker(rightSection, register, Overlay, BG, {
            Name = "Text", Color = Col.Text,
            Callback = function(c) updateTheme("Text", c) end
        })
    end

    function windowObj:Keybind(o)
        o = o or {}
        local key = o.Key or Enum.KeyCode.RightControl
        UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.KeyCode == key or input.UserInputType == key then
                BG.Visible = not BG.Visible
            end
        end)
        return { Get = function() return key end, Set = function(k) key = k end }
    end

    function windowObj:SetVisible(v) BG.Visible = v and true or false end
    function windowObj:Toggle() BG.Visible = not BG.Visible end
    function windowObj:Destroy() BG:Destroy() end
    function windowObj:GetFlags() return Flags end

    -- Drag
    do
        local dragging, dragStart, startPos = false, Vector2.new(0,0), UDim2.new()
        local currentPos, targetPos = BG.Position, BG.Position

        local dragArea = Instance.new("TextButton")
        dragArea.BackgroundTransparency = 1
        dragArea.Text = ""
        dragArea.BorderSizePixel = 0
        dragArea.Size = UDim2.new(1, 0, 0, TITLE_H + 4)
        dragArea.ZIndex = 10
        dragArea.Parent = BG

        dragArea.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = BG.Position
                targetPos = startPos
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                local dx = input.Position.X - dragStart.X
                local dy = input.Position.Y - dragStart.Y
                targetPos = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + dx,
                    startPos.Y.Scale, startPos.Y.Offset + dy)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        RunService.RenderStepped:Connect(function(dt)
            local a = math.clamp(dt * 25, 0, 1)
            local cx = currentPos.X.Offset + (targetPos.X.Offset - currentPos.X.Offset) * a
            local cy = currentPos.Y.Offset + (targetPos.Y.Offset - currentPos.Y.Offset) * a
            currentPos = UDim2.new(currentPos.X.Scale, cx, currentPos.Y.Scale, cy)
            BG.Position = currentPos
        end)
    end

    return windowObj
end

function Library:Window(opts)
    return newWindow(opts)
end

-- ============================================================
-- EXPOSE THEME API
-- ============================================================
local Themes = {
    Presets   = ThemePresets,
    Apply     = applyThemePreset,
    Set       = updateTheme,
    Get       = function(key) return Col[key] end,
    All       = function() local t = {}; for k,v in pairs(Col) do t[k]=v end; return t end,
    OnRefresh = onThemeRefresh,
}

return Library, Notifications, Themes
