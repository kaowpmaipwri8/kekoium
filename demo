local function textStroke(obj, thick)
    local s = Instance.new("UIStroke")
    s.Color = Color3.fromRGB(0,0,0)
    s.Thickness = thick or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
    s.Parent = obj
    return s
end

local function doubleBorder(parent)
    local outer = Instance.new("UIStroke")
    outer.Color = Col.Outer
    outer.Thickness = 1
    outer.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    outer.LineJoinMode = Enum.LineJoinMode.Miter
    outer.Parent = parent

    local inner = Instance.new("UIStroke")
    inner.Color = Col.Inline
    inner.Thickness = 1
    inner.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    inner.BorderStrokePosition = Enum.BorderStrokePosition.Inner
    inner.LineJoinMode = Enum.LineJoinMode.Miter
    inner.Parent = parent

    table.insert(ThemeRegistry, { obj = outer, prop = "Color", key = "Outer" })
    table.insert(ThemeRegistry, { obj = inner, prop = "Color", key = "Inline" })
    outer.Color = Col.Outer
    inner.Color = Col.Inline
    return outer, inner
end

local function sideBorders(parent, sides)
    local function line(key, pos, size, z)
        local f = Instance.new("Frame")
        f.BackgroundColor3 = Col[key]
        f.BorderSizePixel = 0
        f.Position = pos
        f.Size = size
        f.ZIndex = z
        f.Parent = parent
        track(f, "BackgroundColor3", key)
        return f
    end
    local z = (parent.ZIndex or 1) + 1
    if sides.top    then line("Outer", UDim2.new(0,0,0,0),  UDim2.new(1,0,0,1), z) end
    if sides.bottom then line("Outer", UDim2.new(0,0,1,-1), UDim2.new(1,0,0,1), z) end
    if sides.left   then line("Outer", UDim2.new(0,0,0,0),  UDim2.new(0,1,1,0), z) end
    if sides.right  then line("Outer", UDim2.new(1,-1,0,0), UDim2.new(0,1,1,0), z) end
    if sides.top    then line("Inline", UDim2.new(0,1,0,1),  UDim2.new(1,-2,0,1), z) end
    if sides.bottom then line("Inline", UDim2.new(0,1,1,-2), UDim2.new(1,-2,0,1), z) end
    if sides.left   then line("Inline", UDim2.new(0,1,0,1),  UDim2.new(0,1,1,-2), z) end
    if sides.right  then line("Inline", UDim2.new(1,-2,0,1), UDim2.new(0,1,1,-2), z) end
end

local function makeLabel(parent, text, size, color, xAlign, yAlign)
    local l = Instance.new("TextLabel")
    l.FontFace = Fonts.Main
    l.Text = text
    l.TextSize = math.floor((size or 13) * Scale)
    l.TextColor3 = color or Col.Text
    l.BackgroundTransparency = 1
    l.BorderSizePixel = 0
    l.TextXAlignment = xAlign or Enum.TextXAlignment.Left
    l.TextYAlignment = yAlign or Enum.TextYAlignment.Center
    l.Parent = parent
    textStroke(l)
    return l
end

local KEY_NAMES = {
    [Enum.UserInputType.MouseButton1]="MB1",
    [Enum.UserInputType.MouseButton2]="MB2",
    [Enum.UserInputType.MouseButton3]="MB3",
    [Enum.KeyCode.LeftShift]="LS",[Enum.KeyCode.RightShift]="RS",
    [Enum.KeyCode.LeftControl]="LC",[Enum.KeyCode.RightControl]="RC",
    [Enum.KeyCode.LeftAlt]="LA",[Enum.KeyCode.RightAlt]="RA",
    [Enum.KeyCode.CapsLock]="CAP",[Enum.KeyCode.Backspace]="BKSP",
    [Enum.KeyCode.Return]="ENT",[Enum.KeyCode.Escape]="ESC",
    [Enum.KeyCode.Space]="SPC",[Enum.KeyCode.Up]="UP",
    [Enum.KeyCode.Down]="DN",[Enum.KeyCode.Left]="LT",
    [Enum.KeyCode.Right]="RT",[Enum.KeyCode.Insert]="INS",
    [Enum.KeyCode.Delete]="DEL",[Enum.KeyCode.Home]="HOM",
    [Enum.KeyCode.End]="END",[Enum.KeyCode.PageUp]="PGU",
    [Enum.KeyCode.PageDown]="PGD",[Enum.KeyCode.Tab]="TAB",
}
local function keyToString(k)
    if not k then return "NONE" end
    if KEY_NAMES[k] then return KEY_NAMES[k] end
    if typeof(k) == "EnumItem" then
        local n = k.Name:gsub("^KeyCode%.",""):gsub("^UserInputType%.","")
        if #n > 4 then n = n:sub(1,4) end
        return n
    end
    return tostring(k)
end
local function stringToKey(s)
    if s == "NONE" then return nil end
    for k, v in pairs(KEY_NAMES) do
        if v == s then return k end
    end
    local ok, kc = pcall(function() return Enum.KeyCode[s] end)
    if ok then return kc end
    local ok2, uit = pcall(function() return Enum.UserInputType[s] end)
    if ok2 then return uit end
    return nil
end

