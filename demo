    box.AnchorPoint = Vector2.new(1, 0.5)
    box.Position = UDim2.new(1, 0, 0.5, 0)
    box.Size = UDim2.fromOffset(math.floor(30 * Scale), math.floor(14 * Scale))
    box.Parent = row
    doubleBorder(box)
    textStroke(box)
    track(box, "BackgroundColor3", "Control")
    track(box, "TextColor3", "TextDim")

    local picking, conn = false, nil
    box.MouseButton1Click:Connect(function()
        if picking then return end
        picking = true
        box.Text = "..."
        if conn then conn:Disconnect() end
        conn = UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                key = input.KeyCode
            elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
                key = Enum.UserInputType.MouseButton1
            elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
                key = Enum.UserInputType.MouseButton2
            elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
                key = Enum.UserInputType.MouseButton3
            else
                return
            end
            picking = false
            box.Text = keyToString(key)
            if conn then conn:Disconnect() end
        end)
    end)

    if opts.Flag then
        register(opts.Flag, keyToString(key), function(v)
            key = stringToKey(v)
            box.Text = keyToString(key)
        end, function() return keyToString(key) end)
    end
    return { Get = function() return key end, Set = function(k)
        key = k; box.Text = keyToString(k)
    end }
end

